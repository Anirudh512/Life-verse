# Local MySQL defaults. The database user needs permission to create the database
# when DATABASE_URL / MYSQL_URL is not set.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=lifeverse
DB_PASSWORD=replace_with_local_password
DB_NAME=lifeverse
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Required for AI-backed features.
GEMINI_API_KEY=replace_with_gemini_api_key

# Optional server and storage settings.
HOST=0.0.0.0
PORT=3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000
UPLOAD_DIR=uploads/capsules
USER_CAPSULE_STORAGE_LIMIT_BYTES=1073741824
