import 'package:flutter/material.dart';
import 'package:provider/provider.dart';
import '../services/capsule_delivery_service.dart';
import '../services/user_state.dart';
import '../services/api_service.dart';

class HomeDashboard extends StatefulWidget {
  const HomeDashboard({super.key});

  @override
  State<HomeDashboard> createState() => _HomeDashboardState();
}

class _HomeDashboardState extends State<HomeDashboard> with WidgetsBindingObserver {
  late PageController _pageController;
  double _currentPageValue = 0.0;

  final List<Map<String, dynamic>> _pillars = [
    {
      "title": "Evolution Matrix",
      "subtitle": "Active Path: Cognitive",
      "icon": Icons.bubble_chart, // Better icon
      "color": Colors.blueAccent,
      "route": "/hde_dashboard"
    },
    {
      "title": "Time Capsule",
      "subtitle": "Next opens in 12 Days",
      "icon": Icons.lock_clock, // Better icon
      "color": Colors.orangeAccent,
      "route": "/time_capsules"
    },
    {
      "title": "Life Atlas",
      "subtitle": "Latest Chapter: College Life",
      "icon": Icons.history_edu,
      "color": Colors.greenAccent,
      "route": "/legacy_timeline"
    },
    {
      "title": "TwinMind",
      "subtitle": "Confidence: 46%",
      "icon": Icons.face_retouching_natural, // Better icon
      "color": Colors.purpleAccent,
      "route": "/digital_twin"
    },
    {
      "title": "Vision Engine",
      "subtitle": "Updated Yesterday",
      "icon": Icons.visibility, // Better icon
      "color": Colors.pinkAccent,
      "route": "/future_simulation"
    },
  ];

  String _username = 'Pioneer';
  bool _isLoading = true;

  @override
  void initState() {
    super.initState();
    WidgetsBinding.instance.addObserver(this);
    _pageController = PageController(viewportFraction: 0.75);
    _pageController.addListener(_handlePageChange);
    _fetchUserData();
    _loadCapsuleSubtitle();
  }

  void _handlePageChange() {
    final page = _pageController.page;
    if (!mounted || page == null) return;
    setState(() {
      _currentPageValue = page;
    });
  }

  @override
  void didChangeAppLifecycleState(AppLifecycleState state) {
    if (state == AppLifecycleState.resumed) {
      final userId = Provider.of<UserState>(context, listen: false).userId;
      if (userId.isNotEmpty) {
        CapsuleDeliveryService.checkAndShowDeliveries(context, userId);
      }
    }
  }

  Future<void> _loadCapsuleSubtitle() async {
    try {
      final userId = Provider.of<UserState>(context, listen: false).userId;
      if (userId.isEmpty) return;
      final data = await ApiService.getAllCapsules(userId);
      if (data['success'] != true || !mounted) return;
      final all = ((data['all'] ?? data['capsules']) as List<dynamic>? ?? [])
          .whereType<Map>()
          .toList();
      if (all.isEmpty) return;
      final next = all.firstWhere(
        (c) => c['isLocked'] == true,
        orElse: () => all.first,
      );
      final remaining = next['timeRemaining'] as String? ?? 'Memories preserved';
      setState(() {
        _pillars[1]['subtitle'] = remaining;
      });
    } catch (_) {}
  }

  Future<void> _fetchUserData() async {
    try {
      final userState = Provider.of<UserState>(context, listen: false);
      final userId = userState.userId;
      if (userId.isNotEmpty) {
        final data = await ApiService.getUserProfile(userId);
        if (!mounted) return;

        if (data['success'] == true) {
          setState(() {
            _username = data['profile']['username'] ?? 'Pioneer';
          });
        }
        
        // Auto-Shift Dimension based on HDE Momentum
        final statsData = await ApiService.getHdeStats(userId);
        if (statsData['success'] == true && statsData['stats'] != null) {
          int momentum = statsData['stats']['momentum'] ?? 50;
          String newDimension = 'neutral';
          if (momentum > 70) newDimension = 'ascended';
          else if (momentum < 30) newDimension = 'shadow';
          
          userState.updateAppState({'dimension': newDimension});
        }
      }
    } catch (e) {
      print('Failed to load profile/stats: $e');
    } finally {
      if (mounted) setState(() => _isLoading = false);
    }
  }

  @override
  void dispose() {
    WidgetsBinding.instance.removeObserver(this);
    _pageController.removeListener(_handlePageChange);
    _pageController.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: const Color(0xFF0A0A0A),
      appBar: AppBar(
        backgroundColor: Colors.transparent,
        elevation: 0,
        centerTitle: true,
        title: const Text('LifeVerse', style: TextStyle(color: Colors.white, fontWeight: FontWeight.bold, letterSpacing: 1.5)),
        actions: [
          Padding(
            padding: const EdgeInsets.only(right: 16.0),
            child: IconButton(
              icon: const Icon(Icons.person, color: Colors.white, size: 28),
              onPressed: () => Navigator.pushNamed(context, '/profile'),
            ),
          ),
        ],
      ),
      body: SafeArea(
        child: SingleChildScrollView(
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              Padding(
                padding: const EdgeInsets.symmetric(horizontal: 20.0, vertical: 10.0),
                child: _isLoading 
                  ? const CircularProgressIndicator() 
                  : Text(
                  "Hey $_username,\nReady to evolve?",
                  style: const TextStyle(
                    color: Colors.white,
                    fontSize: 28,
                    fontWeight: FontWeight.bold,
                    height: 1.2,
                  ),
                ),
              ),
              const SizedBox(height: 20),
              // The Pulse
              const Center(child: _ThePulse()),
              const SizedBox(height: 40),
              SizedBox(
                height: 380, // Restrict height to make room for the orb
                child: PageView.builder(
                  controller: _pageController,
                  itemCount: _pillars.length,
                  itemBuilder: (context, index) {
                    // Calculate scaling and opacity for the 3D effect
                    double difference = index - _currentPageValue;
                    double scale = 1 - (difference.abs() * 0.2);
                    double opacity = 1 - (difference.abs() * 0.4);
                    
                    scale = scale.clamp(0.8, 1.0);
                    opacity = opacity.clamp(0.3, 1.0);

                    return Opacity(
                      opacity: opacity,
                      child: Transform.scale(
                        scale: scale,
                        child: _InteractiveCarouselCard(
                          data: _pillars[index],
                        ),
                      ),
                    );
                  },
                ),
              ),
              const SizedBox(height: 60),
            ],
          ),
        ),
      ),
    );
  }
}

class _InteractiveCarouselCard extends StatefulWidget {
  final Map<String, dynamic> data;

  const _InteractiveCarouselCard({required this.data});

  @override
  State<_InteractiveCarouselCard> createState() => _InteractiveCarouselCardState();
}

class _InteractiveCarouselCardState extends State<_InteractiveCarouselCard> with SingleTickerProviderStateMixin {
  late AnimationController _animController;
  late Animation<double> _scaleAnimation;

  @override
  void initState() {
    super.initState();
    _animController = AnimationController(
      vsync: this,
      duration: const Duration(milliseconds: 100),
    );
    _scaleAnimation = Tween<double>(begin: 1.0, end: 0.93).animate(
      CurvedAnimation(parent: _animController, curve: Curves.easeInOut),
    );
  }

  @override
  void dispose() {
    _animController.dispose();
    super.dispose();
  }

  void _onTapDown(TapDownDetails details) {
    _animController.forward();
  }

  void _onTapUp(TapUpDetails details) {
    _animController.reverse().then((value) {
      if (!mounted) return;
      if (widget.data['route'].isNotEmpty) {
        Navigator.pushNamed(context, widget.data['route']);
      }
    });
  }

  void _onTapCancel() {
    _animController.reverse();
  }

  @override
  Widget build(BuildContext context) {
    return GestureDetector(
      onTapDown: _onTapDown,
      onTapUp: _onTapUp,
      onTapCancel: _onTapCancel,
      child: AnimatedBuilder(
        animation: _scaleAnimation,
        builder: (context, child) {
          return Transform.scale(
            scale: _scaleAnimation.value,
            child: child,
          );
        },
        child: Container(
          margin: const EdgeInsets.symmetric(vertical: 20),
          decoration: BoxDecoration(
            color: const Color(0xFF151515),
            borderRadius: BorderRadius.circular(30),
            border: Border.all(color: widget.data['color'].withOpacity(0.3), width: 2),
            boxShadow: [
              BoxShadow(
                color: widget.data['color'].withOpacity(0.15),
                blurRadius: 30,
                spreadRadius: 5,
              )
            ],
          ),
          child: Column(
            mainAxisAlignment: MainAxisAlignment.center,
            children: [
              Container(
                padding: const EdgeInsets.all(35),
                decoration: BoxDecoration(
                  color: widget.data['color'].withOpacity(0.1),
                  shape: BoxShape.circle,
                ),
                child: Icon(widget.data['icon'], color: widget.data['color'], size: 70),
              ),
              const SizedBox(height: 40),
              Text(
                widget.data['title'],
                textAlign: TextAlign.center,
                style: const TextStyle(
                  color: Colors.white,
                  fontSize: 26,
                  fontWeight: FontWeight.bold,
                  letterSpacing: 1.2,
                ),
              ),
              const SizedBox(height: 10),
              Text(
                widget.data['subtitle'],
                style: const TextStyle(
                  color: Colors.white54,
                  fontSize: 14,
                ),
              ),
            ],
          ),
        ),
      ),
    );
  }
}

class _ThePulse extends StatefulWidget {
  const _ThePulse({super.key});

  @override
  State<_ThePulse> createState() => _ThePulseState();
}

class _ThePulseState extends State<_ThePulse> with SingleTickerProviderStateMixin {
  late AnimationController _pulseController;
  late Animation<double> _scaleAnimation;

  @override
  void initState() {
    super.initState();
    _pulseController = AnimationController(
      vsync: this,
      duration: const Duration(seconds: 2), // Default pulse
    )..repeat(reverse: true);

    _scaleAnimation = Tween<double>(begin: 0.95, end: 1.05).animate(
      CurvedAnimation(parent: _pulseController, curve: Curves.easeInOut),
    );
  }

  @override
  void dispose() {
    _pulseController.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return Consumer<UserState>(
      builder: (context, userState, _) {
        Color orbColor;
        Color shadowColor;
        Duration pulseSpeed;
        String statusText;

        switch (userState.currentDimension) {
          case LifeDimension.ascended:
            orbColor = Colors.cyanAccent;
            shadowColor = Colors.cyan.withOpacity(0.6);
            pulseSpeed = const Duration(milliseconds: 800); // Fast, energetic pulse
            statusText = "Ascended Dimension";
            break;
          case LifeDimension.shadow:
            orbColor = Colors.redAccent;
            shadowColor = Colors.red.withOpacity(0.6);
            pulseSpeed = const Duration(milliseconds: 3000); // Slow, labored pulse
            statusText = "Shadow Dimension";
            break;
          case LifeDimension.neutral:
          default:
            orbColor = const Color(0xFF1E88E5);
            shadowColor = Colors.blue.withOpacity(0.6);
            pulseSpeed = const Duration(seconds: 2); // Steady pulse
            statusText = "Neutral Dimension";
            break;
        }

        if (_pulseController.duration != pulseSpeed) {
          _pulseController.duration = pulseSpeed;
          _pulseController.repeat(reverse: true);
        }

        return Column(
          children: [
            AnimatedBuilder(
              animation: _scaleAnimation,
              builder: (context, child) {
                return Transform.scale(
                  scale: _scaleAnimation.value,
                  child: Container(
                    width: 120,
                    height: 120,
                    decoration: BoxDecoration(
                      shape: BoxShape.circle,
                      gradient: RadialGradient(
                        colors: [Colors.white, orbColor, Colors.black],
                        stops: const [0.1, 0.6, 1.0],
                      ),
                      boxShadow: [
                        BoxShadow(
                          color: shadowColor,
                          blurRadius: 40 * _scaleAnimation.value,
                          spreadRadius: 10 * _scaleAnimation.value,
                        ),
                      ],
                    ),
                  ),
                );
              },
            ),
            const SizedBox(height: 20),
            Text(
              statusText,
              style: TextStyle(
                color: orbColor,
                fontSize: 14,
                letterSpacing: 2,
                fontWeight: FontWeight.bold,
              ),
            ),
          ],
        );
      },
    );
  }
}
